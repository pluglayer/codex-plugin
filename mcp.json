{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pluglayer": {
      "type": "streamable-http",
      "url": "https://mcp.pluglayer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "pluglayer.read",
              "pluglayer.write"
            ],
            "authorizationServerBase": "https://api.pluglayer.com/v1/mcp/oauth",
            "authorizationUrl": "https://api.pluglayer.com/v1/mcp/oauth/authorize",
            "tokenUrl": "https://api.pluglayer.com/v1/mcp/oauth/token",
            "registrationUrl": "https://api.pluglayer.com/v1/mcp/oauth/register",
            "resource": "https://mcp.pluglayer.com/mcp"
          }
        }
      }
    }
  }
}
